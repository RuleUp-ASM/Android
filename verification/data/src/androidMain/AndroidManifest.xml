<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect(connect-client)는 minSdk 26 이나 앱은 24 지원 → 라이브러리 minSdk 충돌 무시.
         HEALTH/SLEEP 코드 경로는 런타임에 Build.VERSION.SDK_INT>=26 + getSdkStatus 로 가드된다(명세 §8). -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <!-- 자동인증 신호 수집(명세 §4). 앱 매니페스트로 머지된다. -->
    <!-- GPS presence(Geofence) + 보조 측위 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 지오펜스가 앱 종료 중에도 발화하려면 백그라운드 위치(Android 11+ 2단계 허용) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- FG 위치 서비스(동기화 고지) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 재부팅 후 지오펜스 재등록(명세 §2.3 휘발 대응) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 13+ FG 서비스/동기화 고지 알림 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 스크린타임/WAKE: 특수 권한(런타임 아님, Settings 딥링크로 허용). lint ProtectedPermissions 억제. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 움직임·수면(Health Connect, 명세 §8). 데이터타입별 읽기 권한(런타임 grant 은 셋업에서 §4). -->
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- Android 11+ 가시성: getSdkStatus 가 Health Connect 앱 설치 여부를 확인하려면 패키지 노출 필요. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>
        <!-- 지오펜스 전이 수신(내부 PendingIntent 전용) -->
        <receiver
            android:name=".signal.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- 재부팅 후 지오펜스 재등록 -->
        <receiver
            android:name=".signal.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
