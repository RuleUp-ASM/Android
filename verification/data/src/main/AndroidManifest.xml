<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 지오펜스 등록/발화 + 보조 측위(§2.1). 앱이 죽은 상태에서도 지오펜스가 발화하려면
         백그라운드 위치가 필요하다(전경/최근 실행은 FINE 만으로 동작). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 재부팅 후 지오펜스 재등록(BootReceiver, §2.3). OS 등록은 부팅 시 소멸한다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- VPN 활성 여부 동기 게이트(NetworkStateProvider, 전송 스펙 §6.1). 설치 시 자동 부여되는
         일반 권한이지만 ConnectivityManager 접근에는 매니페스트 선언이 필요하다(MissingPermission). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- expedited catch-up sync 가 API 31 미만에서 foreground service 로 승격될 때 필요
         (VerificationSyncWorker.getForegroundInfo, 전송 스펙 §0.6). DATA_SYNC 는 API 34+ 전용. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 스크린타임/WAKE 특수권한(사용기록 접근, §4). 런타임 권한이 아니라 Settings 에서 토글하는
         보호 권한이라 lint(ProtectedPermissions)를 억제한다. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Health Connect 온디바이스 읽기 권한(움직임·수면, §4). HealthPermissions.readPermissions() 와 1:1. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- Android 11+ 패키지 가시성: Health Connect 가용성(getSdkStatus) 조회용(API 34 미만 분리 APK). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>
        <!-- WorkManager 의 foreground service 승격 경로에 dataSync 타입을 부여(SpecifyForegroundServiceType).
             work-runtime 이 선언한 SystemForegroundService 에 속성만 병합한다. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- 지오펜스 전이 수신(§2.1). 앱이 만든 '명시적' PendingIntent(geofencePendingIntent)로만
             Play Services 가 호출하므로 외부 노출 불필요 → exported=false. -->
        <receiver
            android:name="com.ruleup.verification.data.signal.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- 재부팅 재등록(§2.3). 시스템이 BOOT_COMPLETED 브로드캐스트를 보내므로 exported=true.
             DB(ruleup_verification.db)는 자격증명 암호화 저장소라 잠금해제(BOOT_COMPLETED) 이후에만
             접근 가능 → directBootAware 미지정(LOCKED_BOOT_COMPLETED 는 의도적으로 미수신). -->
        <receiver
            android:name="com.ruleup.verification.data.signal.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
