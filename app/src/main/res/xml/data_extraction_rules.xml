<?xml version="1.0" encoding="utf-8"?><!--
   데이터 추출 규칙 (API 31+). 인증 토큰 DataStore 는 클라우드 백업·기기 이전(D2D) 모두에서 제외한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/token.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/token.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
