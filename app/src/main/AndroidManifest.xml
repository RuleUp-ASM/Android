<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 네트워크: Retrofit API 호출 + FCM·Crashlytics·Amplitude 업로드에 필수 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- sync 워커 포그라운드 알림(API33+). 수집 자체를 막지는 않지만 디버그 권한 트리거에서 함께 요청. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 대상 앱 등록 화면에서 설치된 실행 가능한 앱 목록 조회(Android 11+ 패키지 가시성). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidRuleUp">

        <!-- singleTask: 딥링크(VIEW)·재실행이 항상 기존 인스턴스의 onNewIntent 로 들어오게 한다.
             standard 이면 인스턴스가 중복 생성되어, 싱글톤 NavigationHelper 의 신호를 두 NavHost 가
             나눠 소비해 보이는 화면이 전환되지 않는 버그가 있었다(#94). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AndroidRuleUp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: 친구 초대 /inv/{code}.
                 autoVerify 검증은 설치 시점에 /.well-known/assetlinks.json 으로 수행된다.
                 앱 미설치 유저는 같은 URL이 웹 랜딩(스토어 안내)으로 열린다.

                 감시자 초대 /w/{token} 은 여기 없다 — 비유저 감시자를 포함해 웹 동의 페이지가
                 수락을 담당하므로, 앱 설치 여부와 무관하게 브라우저로 열려야 한다.

                 앱 화면으로 직결되는 URL 은 없다. 알림 탭은 MainActivity 를 명시한 인텐트로
                 처리하므로(#179) 필터가 필요 없고, 그 덕에 **웹페이지가 앱 화면을 여는 경로가 0** 이다. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="android.ruleup.co.kr"
                    android:pathPrefix="/inv" />
            </intent-filter>

            <!-- Health Connect 권한 사용 이유(개인정보 처리방침) 안내 — Android 13 이하.
                 HC 가 권한 부여 화면에서 본 액션으로 앱을 호출한다(명세 §8 셋업). -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+(API 34): Health Connect 권한 사용 이유 진입점. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />

                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- FCM 수신. 데이터 전용 메시지만 오고, 지금은 알림을 띄우는 type 이 없다(RuleUpMessagingService). -->
        <service
            android:name=".push.RuleUpMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- WorkManager 기본 이니셜라이저 제거 → App(Configuration.Provider)로 on-demand 초기화.
             Hilt 주입 WorkerFactory 를 쓰기 위함(명세 §3). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>